# NIKTO_PATH=C:/Tools/nikto/program/nikto.pl
# PERL_PATH=C:/Strawberry/perl/bin/perl.exe
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
